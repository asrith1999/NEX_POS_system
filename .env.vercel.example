# Copy values into Vercel environment settings. Never commit real secrets.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://asrith-nexus-pos.vercel.app
APP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
# Supplied by the TiDB Cloud connection; do not duplicate secrets in source.
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
TRUST_PROXY=true
POS_MIGRATE=0
POS_SEED=0
